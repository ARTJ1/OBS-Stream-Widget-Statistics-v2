# Embedded OCR binaries (fetched at build time via scripts/fetch-tesseract.ps1)
internal/owtracker/assets/tesseract/*
!internal/owtracker/assets/tesseract/.gitkeep

node_modules/
.venv/
venv/
__pycache__/
*.pyc

# Build / dist
dist/
build/
*.exe
*.exe~
*.app
widget-stats.exe

# Local runtime / secrets
.env
.env.*
!.env.example
state.json
settings.json
runtime.json
*.lock
*.log
*.wreq
data/*
!data/.gitkeep
!data/.gitignore
data/uploads/

# Source icon dumps (clean copies live under web/overlay/assets/)
Apex icon/

# OS / editor
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp

streamdock-icons-live-*.zip

